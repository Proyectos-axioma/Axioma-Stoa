---
// Página de todos los productos
import Layout from '../../layouts/Layout.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import { Icon } from 'astro-icon/components';
const productos = await getCollection('productos');
// Extraemos Categorías y Subcategorías
const categoriasMap = new Map();
const subcategoriasMap = new Map();
productos.forEach((p) => {
    p.data.categorias.forEach((cat: string) => {
        categoriasMap.set(cat, (categoriasMap.get(cat) || 0) + 1);
    });
// Como subcategorias es opcional, revisamos si existe antes de iterar
    if (p.data.subcategorias) {
        p.data.subcategorias.forEach((sub: string) => {
            subcategoriasMap.set(sub, (subcategoriasMap.get(sub) || 0) + 1);
        });
    }
});
const categoriasUnicas = Array.from(categoriasMap.entries()).sort();
const subcategoriasUnicas = Array.from(subcategoriasMap.entries()).sort();
---
<Layout title={`Catálogo de Productos - ${SITE_TITLE}`}>
    <main class="container mx-auto px-4 py-8 flex flex-col md:flex-row gap-8">
<!-- BARRA LATERAL -->
        <aside class="w-full md:w-64 flex-shrink-0">  
<!-- Botón de filtros exclusivo para móviles -->
            <button id="btn-filtros" class="btn btn-neutral w-full mb-6 md:hidden flex items-center justify-between">
                <span class="flex items-center gap-2">
                    <Icon name="tabler:filter-search" class="w-6 h-6 stroke-2" />
                    Filtrar Categorías
                </span>
                <Icon id="icono-filtros" name="tabler:arrow-badge-down-filled" class="w-6 h-6 stroke-2 transition-transform duration-300" />
            </button>
<!-- Contenedor que se oculta en móvil (hidden) y siempre se ve en PC (md:block) -->
            <div id="menu-filtros" class="hidden md:block">
                <h2 class="text-xl font-bold mb-4 border-b border-base-300 pb-2 hidden md:block">Categorías</h2>
                <ul class="menu bg-base-200 w-full rounded-box mb-6">
                    <li>
                        <a href="/productos" class="flex justify-between hover:text-primary">
                            <span>Todos los productos</span>
                            <span class="badge badge-sm">{productos.length}</span>
                        </a>
                    </li>
                    {categoriasUnicas.map(([cat, count]) => (
                        <li>
                            <a href={`/productos?categoria=${encodeURIComponent(cat)}`} class="flex justify-between hover:text-primary">
                                <span>{cat}</span>
                                <span class="badge badge-sm badge-ghost">{count}</span>
                            </a>
                        </li>
                    ))}
                </ul>
<!-- Bloque de Subcategorías -->
                {subcategoriasUnicas.length > 0 && (
                    <>
                        <h2 class="text-xl font-bold mb-4 border-b border-base-300 pb-2 hidden md:block">Subcategorías</h2>
                        <ul class="menu bg-base-200 w-full rounded-box mb-6">
                            {subcategoriasUnicas.map(([sub, count]) => (
                                <li>
                                    <a href={`/productos?subcategoria=${encodeURIComponent(sub)}`} class="flex justify-between hover:text-primary">
                                        <span>{sub}</span>
                                        <span class="badge badge-sm badge-ghost">{count}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </>
                )}
            </div>
        </aside>
<!-- ÁREA PRINCIPAL -->
        <div class="flex-1">
            <div id="info-busqueda" class="hidden mb-6 text-lg">
                Mostrando resultados para: <span id="termino-busqueda" class="font-bold text-primary"></span>
            </div>
            <div id="grid-productos" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {productos.map((producto: any) => (
                    <div 
                    class="producto-item transition-all duration-300"
                    data-nombre={producto.data.nombre}
                    data-categorias={JSON.stringify(producto.data.categorias)}
                    data-subcategorias={JSON.stringify(producto.data.subcategorias || [])}
                    >
                        <ProductoCard 
                        titulo={producto.data.nombre}
                        precio={producto.data.precio}
                        precioDescuento={producto.data.precioDescuento}
                        imagen={producto.data.imagenPrincipal}
                        disponible={producto.data.disponibilidad}
                        url={`/productos/${producto.id}`} 
                        />
                    </div>
                ))}
            </div>
            <div id="sin-resultados" class="hidden text-center py-20">
                <h3 class="text-2xl font-bold opacity-50">No se encontraron productos.</h3>
                <p class="opacity-50 mt-2">Intenta con otra palabra o categoría.</p>
                <a href="/productos" class="btn btn-outline mt-6">Ver todo</a>
            </div>
        </div>
    </main>
</Layout>
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const normalizar = (texto) => {
            return texto ? texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase() : '';
        };
        const params = new URLSearchParams(window.location.search);
        const busquedaOriginal = params.get('q');
        const busquedaNormalizada = normalizar(busquedaOriginal);
        const categoriaFiltro = params.get('categoria');
// Capturamos la subcategoría de la URL
        const subcategoriaFiltro = params.get('subcategoria');
        const productos = document.querySelectorAll('.producto-item');
        const infoBusqueda = document.getElementById('info-busqueda');
        const terminoBusqueda = document.getElementById('termino-busqueda');
        const sinResultados = document.getElementById('sin-resultados');
        let visibles = 0;
// --- LÓGICA DEL BOTÓN DE FILTROS EN MÓVIL ---
        const btnFiltros = document.getElementById('btn-filtros');
        const menuFiltros = document.getElementById('menu-filtros');
        const iconoFiltros = document.getElementById('icono-filtros');
        if (btnFiltros && menuFiltros) {
            btnFiltros.addEventListener('click', () => {
                menuFiltros.classList.toggle('hidden');
// Gira la flechita del botón cuando se abre/cierra
                if (iconoFiltros) iconoFiltros.classList.toggle('rotate-180'); 
            });
        }
        if (busquedaOriginal || categoriaFiltro || subcategoriaFiltro) {
            infoBusqueda.classList.remove('hidden');
// Muestra el nombre de lo que estés filtrando
            terminoBusqueda.textContent = busquedaOriginal ? `"${busquedaOriginal}"` : (categoriaFiltro || subcategoriaFiltro);
        }
        productos.forEach(producto => {
            const nombreProducto = normalizar(producto.getAttribute('data-nombre'));
            const categorias = JSON.parse(producto.getAttribute('data-categorias') || '[]');
// Extraemos el array de subcategorías de la tarjeta
            const subcategorias = JSON.parse(producto.getAttribute('data-subcategorias') || '[]');
            let coincideBusqueda = true;
            let coincideCategoria = true;
            let coincideSubcategoria = true;
            if (busquedaNormalizada) {
                coincideBusqueda = nombreProducto.includes(busquedaNormalizada);
            }
            if (categoriaFiltro) {
                coincideCategoria = categorias.includes(categoriaFiltro);
            }
// Validamos la coincidencia exacta
            if (subcategoriaFiltro) {
                coincideSubcategoria = subcategorias.includes(subcategoriaFiltro);
            }
// Si cumple con todas las condiciones activas, se muestra
            if (coincideBusqueda && coincideCategoria && coincideSubcategoria) {
                producto.style.display = 'block';
                visibles++;
            }
            else {
                producto.style.display = 'none';
            }
        });
        if (visibles === 0) {
            sinResultados.classList.remove('hidden');
        }
    });
</script>