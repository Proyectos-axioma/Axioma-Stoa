---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { 
	title, 
	seoTitle, 
	description, 
	pubDate, 
	updatedDate, 
	heroImage, 
	author, 
	categoria, 
	tags, 
	tiempoLectura 
} = Astro.props;
---

<!doctype html>
<html lang="es-MX">
	<head>
<!-- Usamos seoTitle si lo llenaste, si no, usa el title por defecto -->
		<BaseHead title={seoTitle || title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="container mx-auto px-4 py-12">
			<article class="max-w-4xl mx-auto bg-base-100 rounded-3xl shadow-xl overflow-hidden">
				{heroImage && (
  					<Image width={1020} height={510} src={heroImage} alt={title} class="w-full h-[40vh] object-cover" />
				)}
				
				<div class="p-6 md:p-12">
					<!-- Encabezado con Fecha y Tiempo -->
					<div class="flex flex-wrap items-center justify-between gap-4 mb-6 text-sm opacity-80">
						<div class="flex items-center gap-2">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<span>(Actualizado: <FormattedDate date={updatedDate} />)</span>
							)}
						</div>
						{tiempoLectura && (
							<span class="badge badge-neutral">{tiempoLectura} min de lectura</span>
						)}
					</div>

					<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-4 leading-tight">{title}</h1>
					
					<!-- Autor y Categoría -->
					<div class="flex flex-wrap items-center gap-3 mb-8">
						<span class="font-semibold text-primary">Por {author}</span>
						{categoria && (
							<>
								<span class="opacity-50">|</span>
								<span class="badge badge-outline">{categoria}</span>
							</>
						)}
					</div>
					<div class="divider"></div>
<!-- Contenido Markdown usando DaisyUI prose -->
					<div class="prose prose-base sm:prose-lg max-w-none prose-img:rounded-xl">
						<slot />
					</div>
					<!-- Etiquetas al final del post -->
					{tags && tags.length > 0 && (
						<div class="mt-12 pt-6 border-t border-base-200">
							<h3 class="text-lg font-bold mb-3">Etiquetas</h3>
							<div class="flex flex-wrap gap-2">
								{tags.map((tag: string) => (
									<span class="badge badge-ghost">#{tag}</span>
								))}
							</div>
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>