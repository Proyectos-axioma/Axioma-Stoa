---
// Ofertas destacadas
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

const productos = await getCollection('productos');
// Agregamos la validación de stock al filtro de destacados
const destacados = productos.filter((producto: CollectionEntry<'productos'>) => producto.data.destacado === true && producto.data.disponibilidad
);
---
{destacados.length > 0 && (
    <section class="relative w-full mb-12">
<!-- Agregamos un ID, select-none y cambios de cursor -->
        <div id="carrusel-hero" class="carousel w-full scroll-smooth cursor-grab active:cursor-grabbing select-none overflow-x-auto no-scrollbar">
            {destacados.map((producto: CollectionEntry<'productos'>, index: number) => (
                <div id={`slide-${index}`} class="carousel-item relative w-full snap-start">
                    <div class="hero min-h-[60vh] bg-base-200 pb-12 lg:pb-0 pointer-events-none">
<!-- pointer-events-auto a los elementos interactivos para que el drag funcione sobre el fondo -->
                        <div class="hero-content flex-col lg:flex-row-reverse w-full max-w-7xl justify-between px-4 py-8 lg:p-12 pointer-events-auto">
<!-- draggable="false" para evitar el "ghost drag" de la imagen -->
                            <Image 
                            src={producto.data.imagenPrincipal} 
                            alt={producto.data.nombre} 
                            draggable="false"
                            class="w-full max-w-xs sm:max-w-sm lg:max-w-lg object-contain drop-shadow-2xl mb-8 lg:mb-0 rounded-xl"
                            />
                            <div class="max-w-xl flex flex-col items-center text-center lg:items-start lg:text-left w-full">
                                <p class="text-xs md:text-sm uppercase tracking-[0.2em] opacity-60 mb-3 font-semibold">
                                    {producto.data.categorias[0]}
                                </p>
                                <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-4">
                                    {producto.data.nombre}
                                </h1>
                                <p class="text-base sm:text-lg opacity-80 mb-8 line-clamp-2">
                                    {producto.data.descripcion}
                                </p>
                                <a href={`/productos/${producto.id}`} class="btn btn-primary btn-md lg:btn-lg rounded-none px-8 w-full sm:w-auto">
                                    Cómpralo
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            ))}
        </div>
        {destacados.length > 1 && (
            <div class="absolute bottom-4 w-full flex justify-center gap-3">
                {destacados.map((_, index: number) => (
                    <a 
                    href={`#slide-${index}`} 
                    class="w-3 h-3 rounded-full bg-base-content/20 hover:bg-base-content transition-colors focus:bg-base-content"
                    aria-label={`Ir al producto destacado ${index + 1}`}
                    >
                    </a>
                ))}
            </div>
        )}
    </section>
)}
<!-- Lógica de arrastre para PC -->
<script is:inline>
    const slider = document.getElementById('carrusel-hero');
    if (slider) {
        let isDown = false;
        let isDragging = false;
        let startX;
        let scrollLeft;
        slider.addEventListener('mousedown', (e) => {
            isDown = true;
            isDragging = false;
            startX = e.pageX - slider.offsetLeft;
            scrollLeft = slider.scrollLeft;
// Quitamos el snap temporalmente para que el arrastre no pelee con el imán de CSS
            slider.style.scrollSnapType = 'none';
        });
        slider.addEventListener('mouseleave', () => {
            isDown = false;
            slider.style.scrollSnapType = '';
        });
        slider.addEventListener('mouseup', () => {
            isDown = false;
            slider.style.scrollSnapType = '';
        });
        slider.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            const x = e.pageX - slider.offsetLeft;
            if (Math.abs(x - startX) > 5) {
                isDragging = true;
            }
            e.preventDefault();
            const walk = (x - startX) * 1.5; // Multiplicador de velocidad (1.5x)
            slider.scrollLeft = scrollLeft - walk;
        });
        slider.addEventListener('click', (e) => {
            if (isDragging) {
                e.preventDefault();
                e.stopPropagation();
                isDragging = false;
            }
        }, true);
    }
</script>